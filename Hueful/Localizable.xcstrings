    "Ratings follow the WCAG accessibility guidelines: Excellent is level AAA (7:1 or more), Good is level AA (4.5:1), Headings Only is level AA for large text (3:1).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giudizi seguono le linee guida di accessibilità WCAG: Ottimo è il livello AAA (7:1 o più), Buono il livello AA (4,5:1), Solo titoli il livello AA per testo grande (3:1)."
          }
        }
      }
    },
