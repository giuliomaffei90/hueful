    "The closest color in each collection. Screen colors only approximate real paints, inks and pencils.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore più vicino in ogni collezione. I colori sullo schermo approssimano soltanto vernici, inchiostri e matite reali."
          }
        }
      }
    },
